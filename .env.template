# HALOmed Pharmacy Management System
# Environment Variables Template
# Copy this file to .env in each module and update values

# ====== BACKEND CONFIGURATION ======
# Database Connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=halomed_user
DB_PASSWORD=halomed_pass123
DB_NAME=halomed_pharmacy

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRY=7d

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Settings
CORS_ORIGIN=http://localhost:3000

# ====== FRONTEND CONFIGURATION ======
# API Base URL
VITE_API_URL=http://localhost:5000

# ====== ML MODULE CONFIGURATION ======
# Flask Server
FLASK_ENV=development
FLASK_PORT=5000
FLASK_DEBUG=True

# Backend Communication
BACKEND_URL=http://localhost:5000

# ====== OPTIONAL: PAYMENT GATEWAY ======
# Stripe (for payment processing)
STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx

# ====== OPTIONAL: EMAIL CONFIGURATION ======
# Gmail SMTP
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@halomed.com

# ====== OPTIONAL: AWS S3 (for file storage) ======
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_BUCKET_NAME=halomed-pharmacy
AWS_REGION=us-east-1

# ====== OPTIONAL: ANALYTICS ======
# Google Analytics
GA_TRACKING_ID=UA-XXXXXXXXX-X

# Sentry Error Tracking
SENTRY_DSN=https://xxxx@sentry.io/xxxx

# ====== OPTIONAL: LOGGING ======
# Log Level: error, warn, info, debug, trace
LOG_LEVEL=info

# ====== SECURITY ====== 
# Password hashing rounds (bcryptjs)
BCRYPT_ROUNDS=10

# Rate limiting (requests per minute)
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_REQUESTS=100

# Session timeout (minutes)
SESSION_TIMEOUT=30
